        "read:quotes"
      ]
    }
  ],
  "commands": [
    {
      "name": "benchmark",
      "description": "Run a price benchmark"
    }
  ],
  "subagents": [
    {
      "name": "comp-analyst",
      "prompt_path": "agents/comp-analyst.md"
    }
  ]
}
